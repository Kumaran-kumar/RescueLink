    <!-- FEAT-01: onboarding -->
    <string name="onboarding_welcome_title">Welcome to RescueLink</string>
    <string name="onboarding_welcome_body">Send SOS alerts and chat with people near you — no internet, no cell signal needed. RescueLink builds a device-to-device mesh so your message hops from phone to phone until it reaches help.</string>
    <string name="onboarding_profile_title">Your profile</string>
    <string name="onboarding_profile_body">This travels with your SOS so responders know who you are and any medical needs. Only your name is required.</string>
    <string name="onboarding_perm_title">A few permissions</string>
    <string name="onboarding_perm_body">• Location — required to discover nearby devices and to tag your SOS with where you are.\n\n• Bluetooth &amp; nearby Wi-Fi — used to form the offline mesh.\n\n• Notifications — so you\'re alerted to an incoming SOS even when the app is in the background.\n\nRescueLink works fully offline and never uploads your data.</string>
    <string name="onboarding_next">Next</string>
