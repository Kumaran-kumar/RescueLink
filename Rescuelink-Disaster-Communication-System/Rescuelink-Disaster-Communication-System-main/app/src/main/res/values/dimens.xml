<?xml version="1.0" encoding="utf-8"?>
<!--
    UI-01: spacing + typography tokens. Spacing follows an 8dp grid (with a 4dp
    half-step). Type scale is a simple major-third-ish ramp. Prefer these tokens
    over hard-coded dp/sp so the design stays consistent.
-->
<resources>
    <!-- Spacing (8dp grid) -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- Minimum accessible touch target (FEAT-07 / UI: 48dp) -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">16dp</dimen>
    <dimen name="radius_lg">20dp</dimen>

    <!-- Type scale -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_subhead">16sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_headline">26sp</dimen>
    <dimen name="text_display">32sp</dimen>
</resources>
