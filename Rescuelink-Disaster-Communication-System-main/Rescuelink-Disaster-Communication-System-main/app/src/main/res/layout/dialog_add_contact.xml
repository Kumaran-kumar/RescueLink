<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Emergency Contact"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etContactName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/contact_name_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etContactPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/contact_phone_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="phone"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etContactRelation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/contact_relation_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="text" />
</LinearLayout>
