<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/save_place_hint"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlaceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_place_category"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipCatHome"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_home" android:checked="true" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatHospital"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_hospital" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatCare"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_care_center" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatShelter"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_shelter" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatPolice"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_police" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatWater"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_water" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCatCustom"
                style="@style/ChipStyle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cat_custom" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/save_place_favorite"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
