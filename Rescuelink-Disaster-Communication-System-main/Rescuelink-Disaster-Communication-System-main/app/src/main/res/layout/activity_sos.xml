<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped in a ScrollView so the SOS content (incl. the I-am-safe/Resend row and
     the name field) is reachable on small screens without clipping. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:gravity="center_horizontal">

    <!-- TWO-WAY: responder-update banner (hidden until a responder status hops back). -->
    <TextView
        android:id="@+id/responderBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_safe"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:padding="14dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- FEAT-SIREN-02: siren-active banner (hidden until siren is pulsing). -->
    <LinearLayout
        android:id="@+id/sirenBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/status_danger"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSirenStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/siren_active"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSirenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSilence"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/siren_silence"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            android:textColor="@color/status_danger" />
    </LinearLayout>

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sos_title"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- SH-02: mesh status banner -->
    <include layout="@layout/view_mesh_status" />

    <!-- Location Info -->
    <androidx.cardview.widget.CardView
        style="@style/CardStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Your Location"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetching GPS coordinates…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvBatteryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 Battery: --%%"
                android:textColor="@color/status_warning"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Emergency Details (rule-based keyword triage) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/describe_situation_label"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />
        
    <EditText
        android:id="@+id/etEmergencyDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_bg"
        android:gravity="top|start"
        android:hint="e.g., 'Trapped under rubble, leg broken, need help...'"
        android:inputType="textMultiLine"
        android:lines="3"
        android:maxLines="4"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupEmergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        app:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFlood"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_flood"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEarthquake"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_earthquake"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFire"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_fire"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMedical"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_medical"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCyclone"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_cyclone"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipOther"
            style="@style/ChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emergency_other"
            android:checkable="true" />
    </com.google.android.material.chip.ChipGroup>

    <!-- SOS Button -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <!-- Pulse Ring Animation View -->
        <View
            android:id="@+id/pulseView"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/sos_button_bg"
            android:alpha="0.3" />

        <Button
            android:id="@+id/btnSOS"
            style="@style/SOSButtonStyle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:text="@string/sos_button_text" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSosHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sos_hold_hint"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:paddingHorizontal="40dp" />

    <!-- FEAT-04: I am safe / resend actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="40dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImSafe"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/sos_im_safe"
            android:textColor="@color/status_safe"
            app:strokeColor="@color/status_safe" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResend"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/sos_resend"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/divider" />
    </LinearLayout>

    <!-- User Name Input -->
    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Your Name"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="textPersonName" />

</LinearLayout>
</ScrollView>
